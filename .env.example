# ===========================================================================
# AyurFHIR Bridge — single environment file for the whole repo.
#
#   cp .env.example .env    then fill in the values below.
#
# One .env at the repo root configures every process: the terminology
# microservice (server.js), the backend (backend/src/app.js), the intake
# kiosk (intake/) and the build scripts. There is no second .env anywhere.
# On Vercel, set these same names under Project Settings > Environment
# Variables — do not commit a filled-in .env.
#
# Nothing here is required to boot. With an empty file the portal runs in
# local demo mode: deterministic intake, the bundled terminology, no auth.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Runtime
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# 2. Firebase Web config  (Console > Project settings > General > Your apps)
#    PUBLIC BY DESIGN. These reach the browser via GET /api/v1/auth/config.
#    Security comes from Firestore rules, authorized domains and server-side
#    token verification — never from hiding these values.
#    Sign-in still requires Email/Password under Authentication > Sign-in method.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# 3. Firebase service account  (Console > Project settings > Service accounts)
#    SERVER-ONLY SECRET. Never expose it to the browser, never commit it.
#    Use the path form locally; paste the whole JSON on one line for hosted
#    deploys such as Vercel, where there is no writable file to point at.
#    Cloud Firestore must be enabled (Build > Firestore Database > Create).
#    Set exactly one of the two.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# 4. Bootstrap admins. Comma-separated emails that get role=admin on first
#    sign-in. Everyone else starts as a practitioner; roles can only be
#    changed server-side afterwards. These must be emails you actually sign
#    up with (Email/Password) — not the service account's gserviceaccount.com
#    address above, which is a server-only identity.
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAILS=

# ---------------------------------------------------------------------------
# 5. WHO ICD-11 API — the licensed icd-api container, usually at http://localhost.
#    It serves the classification without OAuth, so no client id/secret is needed.
#    Leave ICD_API_RELEASE_ID empty to use whichever release the container ships,
#    which survives container upgrades. These names are read by server.js, the
#    backend and scripts/build-terminology.js alike.
# ---------------------------------------------------------------------------
ICD_API_BASE_URL=http://localhost
ICD_API_RELEASE_ID=
ICD_API_LINEARIZATION=mms
ICD_API_LANGUAGE=en
ICD_API_TIMEOUT_MS=10000
ICD_API_CACHE_TTL_MS=600000

# ---------------------------------------------------------------------------
# 6. Optional AI layer for the intake kiosk (intake/llm.js).
#    Leave blank to run fully deterministic: the ontology-driven interview,
#    the red-flag rules and the FHIR coding all work without it. A key only
#    adds narrative polishing and lab-report extraction, and every call falls
#    back to the deterministic result on error or timeout.
#
#    Gemini is used when GEMINI_API_KEY is present; Anthropic is the fallback
#    provider if only ANTHROPIC_API_KEY is set. With neither, fully deterministic.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

LLM_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# 7. Local ABHA directory bridge (intake/abha.js). A JSON file of masked demo
#    identities, gitignored. On a read-only filesystem such as Vercel this must
#    point somewhere writable (/tmp) or the directory simply stays in memory.
# ---------------------------------------------------------------------------
ABHA_DIRECTORY_FILE=./data/abha_directory.json

# ---------------------------------------------------------------------------
# 8. Test harness (test.js) — where the smoke suite points itself.
# ---------------------------------------------------------------------------
BASE_URL=http://localhost:3000
