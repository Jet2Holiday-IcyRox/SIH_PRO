PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# 1. Firebase Web config  (Console > Project settings > General > Your apps > Web app)
#    These reach the browser via GET /api/v1/auth/config and are public by design.
#    Sign-in still requires Email/Password to be enabled under Authentication > Sign-in method.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# 2. Service account  (Console > Project settings > Service accounts > Generate new private key)
#    SERVER-ONLY SECRET. Never expose it to the browser and never commit it.
#    Use the path form locally, or paste the whole JSON on one line for hosted deploys.
#    Cloud Firestore must be enabled (Console > Build > Firestore Database > Create database).
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# 3. Bootstrap admins. Comma-separated emails that get role=admin on first sign-in.
#    Everyone else starts as a practitioner; roles can only be changed server-side afterwards.
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAILS=

# ---------------------------------------------------------------------------
# 4. WHO ICD-11 API (the licensed icd-api container, usually run at http://localhost/).
#    It serves the classification without OAuth, so no client id/secret is needed.
#    Leave ICD_API_RELEASE_ID empty to use whichever release the container ships.
# ---------------------------------------------------------------------------
ICD_API_BASE_URL=http://localhost
ICD_API_RELEASE_ID=
ICD_API_LINEARIZATION=mms
ICD_API_LANGUAGE=en
ICD_API_TIMEOUT_MS=10000
ICD_API_CACHE_TTL_MS=600000

# ---------------------------------------------------------------------------
# 5. Optional AI layer for the intake kiosk (intake/llm.js).
#    Leave blank to run fully deterministic: the ontology-driven interview, the
#    red-flag rules and the FHIR coding all work without it. The key only adds
#    narrative polishing and lab-report extraction, and every call falls back to
#    the deterministic result on error or timeout.
# ---------------------------------------------------------------------------
# Gemini is used when GEMINI_API_KEY is present; Anthropic is the fallback provider
# if only ANTHROPIC_API_KEY is set. With neither, the kiosk runs fully deterministic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

LLM_TIMEOUT_MS=12000
