# Vercel already honours .gitignore; this trims what is left.
#
# The duplicated standalone demo stacks. They are byte-copies of the root portal with
# their own servers and their own vendored node_modules, and nothing routes to them in
# production — shipping them would triple the bundle for no gain. Anchored with a
# leading slash: a bare "admin/" would also drop frontend/admin/, the real console.
/client/
/admin/

# Local-only material
/test/
/test.js
brag-output/
graphify-out/
*.xls
*.xlsx
README.md

# Firebase CLI config — rules are deployed with `firebase deploy`, not with the app.
.firebaserc
firebase.json
firestore.rules
firestore.indexes.json
